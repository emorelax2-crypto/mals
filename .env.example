# Порт HTTP-сервера
PORT=3000

# Секрет для подписи токенов сессий (обязательно поменяйте в проде)
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Платежи (подарки за реальные деньги) ----
# Пока ключей нет — кошелёк работает в DEMO-режиме (пополнение без списания денег).
# Как только вставите настоящий ключ Stripe, включатся реальные платежи (Stripe Checkout).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Публичный адрес приложения — нужен для возврата со страницы оплаты
PUBLIC_URL=http://localhost:3000

# TURN-сервер для звонков через мобильные сети / строгие NAT (необязательно, но желательно в проде)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
