# --- Обязательное ---
# Ключ Anthropic API. Получить: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Пароль для входа в админку (/admin)
ADMIN_PASSWORD=change-me-please

# --- Необязательное ---
PORT=3000

# Секрет для подписи сессий админки. Если не задан — генерируется при старте
# (тогда после перезапуска придётся войти заново).
SESSION_SECRET=

# Сколько ответов ИИ обрабатывать одновременно.
# 50 = полсотни диалогов отвечают параллельно, остальные ждут в очереди.
MAX_CONCURRENT_REPLIES=50

# Сколько последних сообщений диалога отправлять в модель как контекст
HISTORY_LIMIT=24

# Публичный адрес сервера — подставляется в код виджета на странице «Подключение»
PUBLIC_URL=http://localhost:3000

# Куда класть базу sqlite (по умолчанию ./data)
DATA_DIR=
